<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Lactase Switch | Virtual Lab</title><style>
:root{--navy:#172944;--teal:#007f89;--sky:#e5f8fb;--amber:#f4ae3e;--ink:#26364b;--muted:#637489;--bg:#f3f7fb}*{box-sizing:border-box}body{margin:0;font:16px/1.5 system-ui,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--ink)}header{background:linear-gradient(120deg,#172944,#006e81);padding:36px max(24px,calc((100vw - 1040px)/2));color:white}header h1{font-size:clamp(30px,5vw,43px);line-height:1.1;margin:10px 0}header p{max-width:760px;color:#d9f4f8;margin:0}.tag{display:inline-block;letter-spacing:.1em;font-size:12px;font-weight:800;color:#88f4e6}main{max-width:1040px;margin:auto;padding:24px 18px 60px}.card{background:white;border-radius:18px;box-shadow:0 6px 24px #132b4410;padding:25px;margin:18px 0}.card h2{font-size:22px;color:var(--navy);margin:0 0 14px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.detail{background:#eaf7fa;border-left:5px solid var(--teal);padding:13px 16px;border-radius:9px}.warn{background:#fff5df;border-left:5px solid #d79111;padding:13px 16px;border-radius:9px}.small{font-size:13px;color:var(--muted)}button{border:0;background:var(--teal);color:white;font:inherit;font-weight:750;padding:11px 16px;border-radius:10px;cursor:pointer}button:hover{filter:brightness(.9)}button.secondary{background:#e7eff4;color:#21435a}button:disabled{background:#a7b6bd;cursor:not-allowed}input{font:inherit;padding:10px;border:1px solid #b8c8d3;border-radius:9px;max-width:100%}.control{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:16px 0}.trialpill{display:inline-block;background:#e5f8fb;color:#076e76;border-radius:30px;padding:6px 13px;font-weight:800}.bench{display:flex;gap:20px;justify-content:center;align-items:end;background:linear-gradient(white 75%,#dce7ed 75%);padding:30px 10px 18px;border-radius:14px;min-height:260px}.sample{text-align:center;flex:1}.cup{width:130px;height:150px;margin:0 auto 8px;border:4px solid #4e8098;border-top:7px solid #41788c;border-radius:8px 8px 22px 22px;clip-path:polygon(0 0,100% 0,88% 100%,12% 100%);background:linear-gradient(to top,#f7f1d9 0 69%,transparent 69%);position:relative}.cup:before{content:"";position:absolute;left:6%;right:6%;top:29%;border-top:2px solid #d4cdaf}.cup.active{box-shadow:inset 0 0 0 100px #f5e9bb66}.strip{display:inline-flex;align-items:center;gap:7px;font-weight:700}.swatch{width:26px;height:26px;border:2px solid #a3b9af;border-radius:5px;display:inline-block;background:#e6ebcf}.swatch.low{background:#b9d28e}.swatch.mid{background:#81b66d}.swatch.high{background:#367d5a}.measure{text-align:center;padding:15px;background:#f1f7fa;border-radius:12px;min-height:104px}table{border-collapse:collapse;width:100%;font-size:15px}th,td{border-bottom:1px solid #e0e8ed;text-align:left;padding:12px}th{background:#e7f5f8;color:#155c6a}td:not(:first-child){text-align:center;font-weight:700}.status{color:#14616b;font-weight:700;min-height:28px}ol li{margin:8px 0}textarea{width:100%;height:95px;border:1px solid #bfced8;border-radius:10px;font:inherit;padding:12px;resize:vertical}.docbox{border:2px dashed #8db6c0;padding:12px;border-radius:12px}.footer{font-size:13px;color:#607284}#screenshottip{display:none}@media(max-width:650px){.grid{grid-template-columns:1fr}.bench{gap:5px}.cup{width:104px;height:130px}.card{padding:18px}table{font-size:13px}th,td{padding:8px}}@media print{body{background:white}header{padding:15px 20px;color:#172944;background:white;border-bottom:3px solid #007f89}header p{color:#243b4d}main{padding:0}.card{break-inside:avoid;box-shadow:none;border:1px solid #ccd9de;margin:12px 0;padding:14px}button,.control.actions,.no-print{display:none!important}#screenshottip{display:block}.grid{grid-template-columns:1fr 1fr}}
</style></head><body><header><div class="tag">BIOLOGY · MOLECULAR BIOLOGY · ACCESSIBLE LAB ALTERNATIVE</div><h1>The Lactase Switch</h1><p>Virtual Investigation · Phase 1 of <em>The Switch and the Gene: Investigating Lactase in People</em></p></header><main><section class="card"><h2>Start here</h2><p>This is the <b>no-materials alternative</b> for students who do not have lactase tablets or glucose testing strips. You will simulate the same two-cup investigation, complete two trials, and use your results in the original lab report.</p><p class="warn"><b>Important scientific note:</b> These are illustrative, simulated glucose-strip readings designed to demonstrate what lactase does. They are not measurements from actual milk and should not be described as real experimental observations. Strip color bands are simplified educational representations, not a manufacturer's scale.</p><div class="control"><label>Student name <input id="student" placeholder="Last, First" autocomplete="name"></label><label>Date <input id="date" type="date"></label></div><p><b>Driving question:</b> Why can some adults digest milk while others cannot, even though they all could as babies?</p><p><b>Prediction:</b> What will happen to the glucose reading when lactase is added to milk?</p><textarea id="prediction" placeholder="I predict ... because ..."></textarea></section><section class="card"><h2>1. Conduct the virtual experiment</h2><p>Both cups begin with equal amounts of regular milk at the same temperature. Use one fresh virtual strip for each test. Add lactase to the Lactase cup only. Observe the cups before treatment and after 10 minutes.</p><div class="control"><span class="trialpill" id="trial-label">Trial 1 of 2</span><b id="clock">Elapsed time: 0 min</b></div><div class="bench"><div class="sample"><div class="cup" id="plaincup"></div><strong>PLAIN MILK</strong><div class="small">No enzyme added</div></div><div class="sample"><div class="cup" id="lactasecup"></div><strong>LACTASE MILK</strong><div class="small" id="enzymlabel">Enzyme not added</div></div></div><div class="control"><button id="testplain">Test Plain Cup</button><button id="testlactase">Test Lactase Cup</button><button id="add" class="secondary" disabled>Add Crushed Lactase</button><button id="wait" class="secondary" disabled>Advance 10 Minutes</button></div><div class="grid"><div class="measure"><div><b>Most recent virtual strip</b></div><div class="strip"><span class="swatch" id="swatch"></span><span id="reading">Not tested yet</span></div><div class="small" id="stripdesc">Dip a strip to reveal a simulated reading.</div></div><div class="measure"><b>Lab notebook</b><div class="status" id="status" aria-live="polite">Test both cups before adding lactase.</div><div class="small" id="instruction">Before-treatment readings must be recorded first.</div></div></div><div class="control actions"><button id="next" style="display:none">Start Trial 2</button><button id="reset" class="secondary">Reset Simulation</button></div></section><section class="card"><h2>2. Record your data</h2><p>The table automatically records each strip test. Transfer these readings to the <b>Phase 1 data table on page 3</b> of your original lab report.</p><div style="overflow-x:auto"><table><thead><tr><th>Condition</th><th>Trial 1</th><th>Trial 2</th></tr></thead><tbody><tr><td>Before, Plain</td><td id="v00">—</td><td id="v01">—</td></tr><tr><td>Before, Lactase</td><td id="v10">—</td><td id="v11">—</td></tr><tr><td>After, Plain</td><td id="v20">—</td><td id="v21">—</td></tr><tr><td>After, Lactase</td><td id="v30">—</td><td id="v31">—</td></tr></tbody></table></div><p class="small">Values are simulated approximate glucose readings, in mg/dL, and do not represent validated urine-strip measurements in milk.</p><div class="docbox"><b>Documentation for the virtual option</b><p>When you have finished both trials, take a screenshot of this page showing your name, date, and completed data table. Insert it in the documentation area on page 5 of your original lab report. You do <b>not</b> need a photo of physical cups.</p><button id="print" class="secondary" onclick="window.print()">Print or Save as PDF</button></div></section><section class="card"><h2>3. Analyze your results</h2><p>Write your responses below or directly in your original report. Use the numbers from your data table as evidence.</p><p><b>Question A:</b> Which cup changed after 10 minutes? Support your answer with data.</p><textarea id="a" placeholder="In Trial 1, ..."></textarea><p><b>Question B:</b> Lactase breaks lactose into glucose and galactose. Why did the virtual glucose reading change in the Lactase cup?</p><textarea id="b"></textarea><p><b>Question C:</b> What stayed the same between the two cups, and what was deliberately changed?</p><textarea id="c"></textarea><p><b>Question D:</b> What is one limitation of using simulated data instead of collecting real observations?</p><textarea id="d"></textarea></section><section class="card"><h2>4. Continue with Phase 2: The DNA switch</h2><ol><li>Open your original <em>LAB 2 - Lactase Switch</em> report.</li><li>Complete the Phase 2 prediction and DNA sequence comparisons, using the sequences on pages 7–8.</li><li>Fill in both Phase 2 tables, calculate the switch-site totals, and answer <b>all five original discussion questions</b>.</li><li>For original discussion Question 1, use the <b>simulated Phase 1 results</b> above. Submit the original completed report with your simulation screenshot.</li></ol><p class="detail"><b>Important:</b> This virtual lab replaces <b>only</b> the physical setup, testing, and photo requirement in Phase 1. It does not replace the original Phase 2 DNA work.</p></section><p class="footer">Educational simulation. Equal volumes and temperatures are controlled. Simulated glucose readings are intentionally illustrative; actual reactions depend on milk, lactase dose, temperature, time, and assay characteristics.</p></main><script>
(()=>{'use strict';const $=id=>document.getElementById(id);$('date').value=new Date().toLocaleDateString('en-CA');let trial=0,phase=0,seen=[false,false],data=Array.from({length:4},()=>[null,null]);const before=[[0,0],[0,0]],after=[[0,0],[250,100]];function update(){for(let r=0;r<4;r++)for(let c=0;c<2;c++)$('v'+r+c).textContent=data[r][c]===null?'—':`${data[r][c]} mg/dL`;$('trial-label').textContent=`Trial ${trial+1} of 2`;$('clock').textContent=`Elapsed time: ${phase===2||phase===3?10:0} min`;$('enzymlabel').textContent=phase===0?'Enzyme not added':'Lactase added';$('lactasecup').classList.toggle('active',phase!==0);$('add').disabled=phase!==0||!seen.every(Boolean);$('wait').disabled=phase!==1;$('testplain').disabled=phase===1||phase===3||seen[0];$('testlactase').disabled=phase===1||phase===3||seen[1];$('next').style.display=phase===3&&trial===0?'inline-block':'none';if(phase===3&&trial===1){$('status').textContent='Both trials complete!';$('instruction').textContent='Take a screenshot and complete the original lab report.'}}
function read(cup){if(phase!==0&&phase!==2)return;if(seen[cup])return;const val=(phase===0?before[cup][trial]:after[cup][trial]);data[(phase===0?0:2)+cup][trial]=val;seen[cup]=true;const label=cup===0?'Plain':'Lactase';$('reading').textContent=`${val} mg/dL`;$('swatch').className='swatch '+(val===0?'':val<200?'mid':'high');$('stripdesc').textContent=`Trial ${trial+1}: ${phase===0?'before':'after'} treatment, ${label} cup`;$('status').textContent=`Recorded ${label} cup: ${val} mg/dL`;$('instruction').textContent='';if(phase===2&&seen.every(Boolean)){phase=3;$('status').textContent=trial===0?'Trial 1 complete. Start Trial 2.':'Both trials complete!'}update()}
$('testplain').onclick=()=>read(0);$('testlactase').onclick=()=>read(1);$('add').onclick=()=>{if(phase!==0||!seen.every(Boolean))return;phase=1;$('status').textContent='Lactase added to one cup only.';$('instruction').textContent='Advance the virtual timer 10 minutes.';update()};$('wait').onclick=()=>{if(phase!==1)return;phase=2;seen=[false,false];$('status').textContent='Ten minutes have passed.';$('instruction').textContent='Test both cups with fresh virtual strips.';update()};$('next').onclick=()=>{if(phase!==3||trial!==0)return;trial=1;phase=0;seen=[false,false];$('reading').textContent='Not tested yet';$('swatch').className='swatch';$('stripdesc').textContent='Dip a strip to reveal a simulated reading.';$('status').textContent='Trial 2: test both cups before adding lactase.';$('instruction').textContent='';update()};$('reset').onclick=()=>{if(!confirm('Reset both trials and erase all readings?'))return;trial=0;phase=0;seen=[false,false];data=Array.from({length:4},()=>[null,null]);$('reading').textContent='Not tested yet';$('swatch').className='swatch';$('status').textContent='Test both cups before adding lactase.';$('instruction').textContent='';update()};update()})();
</script></body></html>
